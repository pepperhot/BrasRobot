.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/settings.json
.venv/
__pycache__/
*.py[cod]

# Config centrale du lab (secrets Wi-Fi / MQTT) : ne jamais commiter.
# -> lab.env.example est le modèle à versionner, lab.env est généré/local.
lab.env

# Généré automatiquement depuis include/config.h.template + lab.env
# par outils/generer_config.py (voir installer_lab.ps1 / start_lab.bat).
include/config.h

# Wordlists d'un 2e poste (ou plus) créées automatiquement par
# outils/generer_config.py pour INSTANCE_ID != 1.
ftp_wordlists_*/

# Identifiants FTP synchronisés depuis lab.env : restent locaux.
/ftp_wordlists/users.txt
/ftp_wordlists/passwords.txt

# Certificats TLS du lab (exercice bonus, voir outils/generer_certs_tls.ps1) :
# régénérés à la demande, ne contiennent rien de réutilisable ailleurs,
# mais autant ne pas les committer.
tls/

# Journal complet du protocole FTP (côté prof, hors du partage) généré par
# outils/serveur_ftp.py à chaque session : contient des données d'activité
# d'étudiants, jamais à committer. Voir GUIDE_PROF.md, section "Journal FTP".
outils/logs/

# Journal visible dans le partage FTP (connexions.log, dans ftp_wordlists/journal/) :
# régénéré à chaque lancement, les étudiants ont le droit de le supprimer/modifier
# (voir GUIDE_ETUDIANT.md) - pas à committer dans tous les cas.
ftp_wordlists/journal/
ftp_wordlists_*/journal/

# Journaux FTP générés à la racine du projet.
/acces_ftp.log
/connexions.log
